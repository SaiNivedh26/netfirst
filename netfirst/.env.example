# Every tunable lives here; the code has no defaults. Copy to .env and fill the blanks.

# --- PayPal (sandbox) ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=20
# PayPal rejects decimals for these even where ISO 4217 allows them
PAYPAL_ZERO_DECIMAL_CURRENCIES=HUF,JPY,TWD
# Used when the PDF has no due date, and for settlement invoices
PAYPAL_PAYMENT_TERM=NET_15

# --- AI: agno + Groq ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AGENT_TOOL_CALL_LIMIT=12
AGENT_TEMPERATURE=0
AGENT_TIMEOUT_SECONDS=60

# --- Exchange rates (ECB is the fallback when no PayPal quote) ---
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
RATES_CACHE_SECONDS=21600
RATE_SIGNIFICANT_DIGITS=10

# --- Ledger defaults: seed the Settings row, editable later via /api/settings ---
BASE_CURRENCY=INR
FX_FEE_PCT=0.044
FX_SPREAD_PCT=0.035
DISPLAY_LOCALE=en_IN

# --- Treatment guardrails (paid invoices a client needs before each treatment) ---
POLICY_TRUE_UP_MIN_PAID=2
POLICY_DEFER_MIN_PAID=3

# --- New-client defaults: balance cap in base-currency major units, settle-by age ---
DEFAULT_CLIENT_CAP=5000
DEFAULT_SETTLE_BY_DAYS=90

# --- App ---
DATABASE_URL=sqlite:///netfirst.db
UPLOAD_DIR=uploads
DEMO_MODE=1
WEB_ORIGIN=http://localhost:5173

# --- scripts/smoke.py only: sandbox personal account that receives test invoices ---
SMOKE_RECIPIENT_EMAIL=
